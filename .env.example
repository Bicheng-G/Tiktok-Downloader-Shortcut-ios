# Generate your own token: python -c "import secrets; print(secrets.token_urlsafe(32))"
DOUYIN_API_TOKEN=REPLACE_WITH_A_RANDOM_TOKEN
# auto: HTTP first, persistent browser fallback. http: no browser, less coverage.
DOUYIN_ENGINE=auto
DOUYIN_BROWSER_CHANNEL=chromium
DOUYIN_BROWSER_TIMEOUT=35
DOUYIN_CACHE_TTL=45
